POSTGRES_PORT=5432
DB_TIME_ZONE=Asia/Seoul

SPRING_PROFILES_ACTIVE=prod
BACKEND_PORT=8080
DB_HOST=postgresql
DB_PORT=5432
DB_NAME=health_center
DB_USERNAME=health
DB_PASSWORD=change-me
APP_TIME_ZONE=Asia/Seoul
JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Seoul
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
MANAGEMENT_METRICS_TAGS_APPLICATION=health-center-backend
INFO_APP_VERSION=local
OBSERVABILITY_PROMETHEUS_SCRAPE_ENABLED=false
QUEUE_AUTO_CLOSE_ENABLED=true
QUEUE_AUTO_CLOSE_CRON=0 10 18 * * *
QUEUE_AUTO_CLOSE_RETENTION_DAYS=2
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ROOT_URL=http://localhost:3001
LOKI_PORT=3100

JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_EXPIRE=3600
JWT_REFRESH_EXPIRE=1209600

OAUTH_FRONTEND_CALLBACK_URL=http://<ubuntu-vm-ip>:3000/login/social/callback
