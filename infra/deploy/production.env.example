# Store the real file at /Users/tro/services/health-center/shared/production.env
# with mode 600. Copy the CURRENT production values; do not use demo credentials.
# This file is parsed by Docker Compose, never sourced by a shell.
DB_NAME=health_center
DB_USERNAME=health
DB_PASSWORD=
JWT_SECRET=
JWT_ACCESS_EXPIRE=3600
JWT_REFRESH_EXPIRE=1209600
ACCOUNT_RECOVERY_RESET_TOKEN_EXPIRE=1800
OAUTH_FRONTEND_CALLBACK_URL=https://demo.healthq.store/login/social/callback
CORS_ALLOWED_ORIGINS=https://demo.healthq.store
NEXT_PUBLIC_API_BASE_URL=https://api.healthq.store
NEXT_PUBLIC_APP_URL=https://demo.healthq.store
# These two NEXT_PUBLIC values must match the image's build-time arguments.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://api.healthq.store/api/auth/social/kakao/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=https://api.healthq.store/api/auth/social/naver/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.healthq.store/api/auth/social/google/callback
OBSERVABILITY_PROMETHEUS_SCRAPE_ENABLED=true
QUEUE_AUTO_CLOSE_ENABLED=true
QUEUE_AUTO_CLOSE_CRON=0 10 18 * * *
QUEUE_AUTO_CLOSE_RETENTION_DAYS=2
